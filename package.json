{
  "name": "linkedfin",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm og:generate && vite dev --port 4141",
    "build": "pnpm og:generate && vite build && pnpm verify:build",
    "pipeline": "pnpm rebuild better-sqlite3 && pnpm og:generate && pnpm check && pnpm tsc --noEmit && pnpm tsc --noEmit -p functions/tsconfig.json && pnpm test && pnpm db:validate && pnpm build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:types": "kysely-codegen --dialect sqlite --url ./public/fish.db --out-file src/db/types.ts && biome check --write src/db/types.ts",
    "db:validate": "tsx maintenance/scripts/validate-integrity.ts",
    "db:fix-page-size": "tsx maintenance/scripts/fix-page-size.ts",
    "og:generate": "tsx maintenance/scripts/og-data-gen.ts",
    "verify:build": "tsx maintenance/scripts/verify-build.ts",
    "fallow": "pnpm og:generate && fallow dead-code --fail-on-regression --tolerance 0 --quiet",
    "fallow:report": "pnpm og:generate && fallow",
    "fallow:fix": "fallow fix --dry-run",
    "fallow:baseline": "fallow dead-code --save-regression-baseline --quiet",
    "fallow:gaps": "fallow health --coverage-gaps",
    "fallow:health": "fallow health --coverage coverage/coverage-final.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@sqlite.org/sqlite-wasm": "3.51.2-build6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "1.169.1",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-start": "1.167.57",
    "@tanstack/react-table": "^9.0.0",
    "@tanstack/router-plugin": "1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.1.0",
    "kysely": "^0.28.11",
    "kysely-generic-sqlite": "^1.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.0.5",
    "better-sqlite3": "^12.6.2",
    "fallow": "^2.56.0",
    "jsdom": "^28.1.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.1.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "wrangler": "^4.73.0"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "fallow",
      "lefthook",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
